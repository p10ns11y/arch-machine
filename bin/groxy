#!/usr/bin/env bash
# groxy — XChat DM remote control entrypoint (prefers Rust satellite, falls back to Python v1).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export GROXY_ROOT="${GROXY_ROOT:-$ROOT}"

RUST_RELEASE="$ROOT/tools/xchat-remote/target/release/groxy"
RUST_DEBUG="$ROOT/tools/xchat-remote/target/debug/groxy"

if [[ -x "$RUST_RELEASE" ]]; then
  exec "$RUST_RELEASE" "$@"
fi
if [[ -x "$RUST_DEBUG" ]]; then
  exec "$RUST_DEBUG" "$@"
fi

# Build debug binary on first use if cargo is available
if command -v cargo >/dev/null 2>&1 && [[ -f "$ROOT/tools/xchat-remote/Cargo.toml" ]]; then
  cargo build --manifest-path "$ROOT/tools/xchat-remote/Cargo.toml" --quiet 2>/dev/null || true
  if [[ -x "$RUST_DEBUG" ]]; then
    exec "$RUST_DEBUG" "$@"
  fi
fi

# Python v1 reference (legacy)
export PYTHONPATH="${ROOT}${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONUNBUFFERED=1
exec python3 -m tools.groxy "$@"
