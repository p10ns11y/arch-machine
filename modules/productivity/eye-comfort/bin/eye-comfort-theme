#!/usr/bin/env bash
# Circadian / manual switcher for eye-comfort Omarchy themes.
# Usage:
#   eye-comfort-theme              # auto from local hour
#   eye-comfort-theme auto
#   eye-comfort-theme day|light    # force light
#   eye-comfort-theme night|dark   # force dark
#   HOUR=22 eye-comfort-theme      # injectable hour (testing)
#   eye-comfort-theme --dry-run …
#   eye-comfort-theme --print-only …  # only print theme name (no omarchy-theme-set)
set -euo pipefail

export PYTHONPATH="${HOME}/.local/lib/eye-comfort${PYTHONPATH:+:$PYTHONPATH}"

MODE="auto"
DRY=0
PRINT_ONLY=0
ARGS=()
for a in "$@"; do
  case "$a" in
    --dry-run) DRY=1 ;;
    --print-only) PRINT_ONLY=1 ;;
    -h|--help)
      sed -n '2,12p' "$0"
      exit 0
      ;;
    *) ARGS+=("$a") ;;
  esac
done
if ((${#ARGS[@]} > 0)); then
  MODE="${ARGS[0]}"
fi

THEME=$(python3 - "$MODE" <<'PY'
import os, sys
from schedule import theme_for_hour, theme_for_mode

mode = sys.argv[1].strip().lower()
if mode in ("auto", ""):
    if "HOUR" in os.environ and os.environ["HOUR"] != "":
        hour = int(os.environ["HOUR"])
    else:
        from datetime import datetime
        hour = datetime.now().hour
    print(theme_for_hour(hour))
else:
    print(theme_for_mode(mode))
PY
)

echo "eye-comfort-theme: mode=$MODE -> $THEME"

if (( PRINT_ONLY )); then
  exit 0
fi

if (( DRY )); then
  echo "(dry-run) would run: omarchy-theme-set $THEME"
  exit 0
fi

# Idempotent: still invoke real path twice-friendly (omarchy-theme-set is the SoT applier)
omarchy-theme-set "$THEME"
# Keep Yazi flavor pointer consistent (theme.toml already dual-flavor; ensure names)
THEME_TOML="${HOME}/.config/yazi/theme.toml"
if [[ -f "$THEME_TOML" ]]; then
  # dual flavors already map dark/light; no rewrite required when Omarchy switches
  :
fi
echo "active: $(cat "${HOME}/.config/omarchy/current/theme.name" 2>/dev/null || echo unknown)"
